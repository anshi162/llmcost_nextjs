# Copy this file to .env and fill in whichever key(s) you have.
# Once set, the Import button on the page works with no typing needed --
# it only asks for a pasted key as a fallback/override.
#
# Get these from:
#   OpenAI:    Org Settings -> Admin Keys       (starts with sk-admin-)
#   Anthropic: Console -> Organization Settings  (starts with sk-ant-admin)
#
# Only works for API-billed orgs -- subscription plans (Pro/Max/Team)
# have no usage API to call.
#
# Never commit your real .env file.

OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
